# ============================================================
# OPPRADAR — Environment Variables
# Discover. Explore. Act.
# ============================================================

# SerpApi API Key (Backend Server Only — NEVER expose to browser)
# Obtain from: https://serpapi.com/manage-api-key
SERPAPI_KEY=your_serpapi_key_here

# Supabase Credentials (Optional for local fallback mode)
# Obtain from: https://supabase.com/dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
